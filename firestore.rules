rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-:\\.@]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }
    
    function hasRole(role) {
      let data = getUserData();
      return data != null && data.role == role;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'achavezsalva@gmail.com') ||
        (getUserData() != null && getUserData().role == 'admin')
      );
    }

    function isStaff() {
      return isSignedIn() && hasRole('staff');
    }

    function isStaffInDept(deptId) {
      let data = getUserData();
      return data != null && data.role == 'staff' && data.department_id == deptId;
    }

    function isCitizen() {
      return isSignedIn() && hasRole('citizen');
    }

    function isValidUser(data) {
      let requiredFields = ['uid', 'name', 'email', 'role', 'created_at'];
      return data.keys().hasAll(requiredFields) &&
             data.keys().size() <= 12 &&
             data.name is string &&
             data.email is string &&
             data.role in ['admin', 'staff', 'citizen'] &&
             (data.created_at is string || data.created_at == request.time);
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['title', 'content', 'department_id', 'author_id', 'created_at']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.content is string && data.content.size() > 0 &&
             data.department_id is string &&
             data.author_id == request.auth.uid &&
             data.created_at == request.time;
    }

    function isValidServiceRequest(data) {
      return data.keys().hasAll(['user_id', 'service_type', 'status', 'created_at']) &&
             data.user_id == request.auth.uid &&
             data.service_type is string &&
             data.status in ['pending', 'processing', 'completed'] &&
             data.created_at == request.time;
    }

    function isValidFeedback(data) {
      return data.keys().hasAll(['user_id', 'user_name', 'message', 'status', 'created_at']) &&
             data.user_id == request.auth.uid &&
             data.user_name is string && data.user_name.size() > 0 &&
             data.message is string &&
             data.status is string &&
             data.created_at == request.time;
    }

    function isValidDepartment(data) {
      return data.keys().hasAll(['id', 'name', 'description', 'head', 'contact', 'services']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.head is string && data.head.size() < 200 &&
             data.description is string && data.description.size() < 2000 &&
             data.contact is map &&
             data.services is list && data.services.size() <= 20;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (
        userId == request.auth.uid || 
        isAdmin() || 
        (isStaff() && resource.data.get('department_id', '') == getUserData().get('department_id', '')) ||
        (request.auth.token.email != null && userId == 'pre_auth:' + request.auth.token.email.lower())
      );
      // More restrictive list gate for staff
      allow list: if isSignedIn() && (isAdmin() || (isStaff() && resource.data.department_id == getUserData().department_id)); 
      
      allow delete: if isAdmin() || (isSignedIn() && request.auth.token.email != null && userId == 'pre_auth:' + request.auth.token.email.lower());
      
      allow create: if isSignedIn() && isValidUser(incoming()) && (
        isAdmin() || 
        incoming().uid == request.auth.uid ||
        (request.auth.token.email != null && exists(/databases/$(database)/documents/users/$( 'pre_auth:' + request.auth.token.email.lower() )))
      );
      
      allow update: if isSignedIn() && (
        isAdmin() || 
        (userId == request.auth.uid && isValidUser(incoming()))
      );
    }

    match /departments/{departmentId} {
      allow read: if true;
      allow create: if (isAdmin() || (isStaff() && getUserData().department_id == departmentId)) && isValidDepartment(incoming());
      allow update: if (isAdmin() || (isStaff() && getUserData().department_id == departmentId)) && isValidDepartment(incoming());
      allow delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create: if (isAdmin() || (isStaff() && getUserData().department_id == incoming().department_id)) &&
                     isValidAnnouncement(incoming());
      allow update: if (isAdmin() || (isStaff() && getUserData().department_id == existing().department_id && getUserData().department_id == incoming().department_id)) &&
                     isValidAnnouncement(incoming()) &&
                     incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'department_id']);
      allow delete: if isAdmin() || (isStaff() && getUserData().department_id == existing().department_id);
    }

    match /service_requests/{requestId} {
      allow list: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow get: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow create: if isSignedIn() && isValidServiceRequest(incoming());
      allow update: if isAdmin() || (isStaff() && incoming().diff(existing()).affectedKeys().hasOnly(['status']));
      allow delete: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow list: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow get: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow create: if isSignedIn() && isValidFeedback(incoming());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
