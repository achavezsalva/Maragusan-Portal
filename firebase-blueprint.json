{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile containing roles and identification",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "staff", "citizen"] },
        "department_id": { "type": "string", "description": "Reference to department ID, nullable for citizens" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email", "role", "created_at"]
    },
    "Department": {
      "title": "Department",
      "description": "Municipal departments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "department_name": { "type": "string" }
      },
      "required": ["id", "department_name"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Government announcements",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "department_id": { "type": "string" },
        "author_id": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "content", "department_id", "author_id", "created_at"]
    },
    "ServiceRequest": {
      "title": "Service Request",
      "description": "Citizen service requests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "service_type": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "processing", "completed"] },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "user_id", "service_type", "status", "created_at"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "Citizen feedback and complaints",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "user_id", "message", "status", "created_at"]
    },
    "PortalConfiguration": {
      "title": "Portal Configuration",
      "description": "Global settings and branding for the municipal portal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "municipality_name": { "type": "string" },
        "logo_url": { "type": "string" },
        "primary_color": { "type": "string" },
        "last_updated": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "municipality_name", "logo_url", "last_updated"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Public user profiles"
    },
    "departments/{departmentId}": {
      "schema": "Department",
      "description": "Municipal departments list"
    },
    "announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Public announcements"
    },
    "service_requests/{requestId}": {
      "schema": "ServiceRequest",
      "description": "Requests filed by citizens"
    },
    "feedback/{feedbackId}": {
      "schema": "Feedback",
      "description": "Feedback submitted by citizens"
    },
    "config/{configId}": {
      "schema": "PortalConfiguration",
      "description": "Core portal settings and branding"
    }
  }
}
