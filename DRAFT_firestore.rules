rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // RBAC Helpers
    // Note: Roles are stored in Firestore, so we need to get(userDoc)
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return getUserData().role == role;
    }

    function isAdmin() {
      return isSignedIn() && hasRole('admin');
    }

    function isStaff() {
      return isSignedIn() && hasRole('staff');
    }

    function isCitizen() {
      return isSignedIn() && hasRole('citizen');
    }

    // Entity Validations
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'created_at']) &&
             data.keys().size() <= 7 &&
             data.uid == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.email is string && data.email.size() > 0 &&
             data.role in ['admin', 'staff', 'citizen'] &&
             data.created_at == request.time;
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['id', 'title', 'content', 'department_id', 'author_id', 'created_at']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.content is string && data.content.size() > 0 &&
             data.department_id is string &&
             data.author_id == request.auth.uid &&
             data.created_at == request.time;
    }

    function isValidServiceRequest(data) {
      return data.keys().hasAll(['id', 'user_id', 'service_type', 'status', 'created_at']) &&
             data.user_id == request.auth.uid &&
             data.service_type is string &&
             data.status in ['pending', 'processing', 'completed'] &&
             data.created_at == request.time;
    }

    function isValidFeedback(data) {
      return data.keys().hasAll(['id', 'user_id', 'message', 'status', 'created_at']) &&
             data.user_id == request.auth.uid &&
             data.message is string &&
             data.status is string &&
             data.created_at == request.time;
    }

    // Collection Rules
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidUser(incoming()) && (incoming().role != 'admin' || isAdmin()); // Admin check prevents hijacking
      allow update: if (isAdmin() || (isSignedIn() && userId == request.auth.uid)) &&
                     isValidUser(incoming()) &&
                     incoming().role == existing().role && // Prevent self-promotion
                     incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'department_id']);
    }

    match /departments/{departmentId} {
      allow read: if true; // Public list
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create: if (isAdmin() || (isStaff() && getUserData().department_id == incoming().department_id)) &&
                     isValidAnnouncement(incoming());
      allow update: if (isAdmin() || (isStaff() && getUserData().department_id == existing().department_id && getUserData().department_id == incoming().department_id)) &&
                     isValidAnnouncement(incoming()) &&
                     incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'department_id']);
      allow delete: if isAdmin() || (isStaff() && getUserData().department_id == existing().department_id);
    }

    match /service_requests/{requestId} {
      allow list: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow get: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow create: if isCitizen() && isValidServiceRequest(incoming());
      allow update: if isAdmin() || (isStaff() && incoming().diff(existing()).affectedKeys().hasOnly(['status']));
      allow delete: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow list: if isAdmin();
      allow get: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow create: if isCitizen() && isValidFeedback(incoming());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
